# tài khoản database
USERNAME_DATABASE=
PASSWORD_DATABASE=

# khóa jwt Rsa
JWT_PUBLIC_KEY=

# vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# supabase: lưu ảnh đánh giá sản phẩm
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_SECRET_KEY=

# host FE: dùng để nối URL trả về và origin được phép
FE_HOST=http://localhost:3000

# profile Spring: local khi chạy từ IDE, docker khi chạy trong container
SPRING_PROFILES_ACTIVE=local
